{
  "name": "pi-t3-bridge",
  "version": "0.9.1",
  "private": true,
  "description": "Pi extension adapter for pstack and tstack inside T3 Code.",
  "keywords": [
    "pi-extension",
    "pi-package",
    "pstack",
    "t3-code"
  ],
  "homepage": "https://github.com/Snestra/pi-t3-bridge#readme",
  "bugs": {
    "url": "https://github.com/Snestra/pi-t3-bridge/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Snestra/pi-t3-bridge.git"
  },
  "workspaces": [
    "pstack/skills/statechart/scripts"
  ],
  "type": "module",
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix",
    "doctor": "ultracite doctor",
    "test": "node --test \"tests/*.test.mjs\" \"pstack/skills/poteto-mode/scripts/**/*.test.ts\"",
    "typecheck": "tsc --project tsconfig.json && tsc --project pstack/skills/poteto-mode/scripts/watch-pr/tsconfig.json && tsc --project pstack/skills/statechart/scripts/tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-schema": "1.5.0",
    "commander": "^15.0.0",
    "marked": "18.0.11",
    "pele": "1.13.0",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^26.6.5",
    "@types/proper-lockfile": "^4.1.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "testcontainers": "^12.2.1",
    "typescript": "^7.0.2",
    "ultracite": "^8.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./bridge.ts",
      "./tstack.ts",
      "./pstack.ts"
    ]
  },
  "upstreams": {
    "t3": "0.1.7",
    "tstack": "1085050f3baed1ac724caa4a8166145fb2ac88af"
  }
}
