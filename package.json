{
  "name": "pi-t3-bridge",
  "version": "0.2.0",
  "description": "Pi extension adapter for t3-pstack inside T3 Code.",
  "keywords": [
    "pi-extension",
    "pi-package",
    "pstack",
    "t3-code"
  ],
  "homepage": "https://github.com/Snestra/pi-t3-bridge#readme",
  "bugs": {
    "url": "https://github.com/Snestra/pi-t3-bridge/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Snestra/pi-t3-bridge.git"
  },
  "files": [
    "bridge.ts",
    "pstack.ts",
    "src",
    "pstack",
    "!pstack/.claude-plugin",
    "!pstack/.codex-plugin",
    "!pstack/assets",
    "!pstack/hooks/*.json",
    "!pstack/hooks/*.sh",
    "!pstack/hooks/*.ps1",
    "!pstack/**/test",
    "!pstack/**/*.test.ts",
    "!pstack/**/*.test-helper.ts",
    "!pstack/**/test-utils",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix",
    "doctor": "ultracite doctor",
    "test": "node --test \"tests/*.test.mjs\" \"pstack/skills/poteto-mode/scripts/**/*.test.ts\"",
    "typecheck": "tsc --project tsconfig.json && tsc --project pstack/skills/poteto-mode/scripts/watch-pr/tsconfig.json"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "marked": "18.0.11",
    "pele": "1.13.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "testcontainers": "^12.2.1",
    "typebox": "1.3.27",
    "typescript": "^7.0.2",
    "ultracite": "^8.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./bridge.ts",
      "./pstack.ts"
    ]
  },
  "upstreams": {
    "t3": "0.1.5-nightly.20261029.3877"
  }
}
